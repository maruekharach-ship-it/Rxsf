-- TP Walk Logic
local tpWalking = false
local tpConnection = nil

local function startTPWalk()
    if tpConnection then tpConnection:Disconnect() end
    
    tpConnection = RunService.Heartbeat:Connect(function()
        if tpWalking and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local chr = LocalPlayer.Character
            local hum = chr.Humanoid
            local hrp = chr.HumanoidRootPart
            local speedMultiplier = tonumber(SpeedInput.Text) or 1
            
            -- ตรวจสอบว่าผู้เล่นกำลังเดินอยู่หรือไม่
            if hum.MoveDirection.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection * speedMultiplier)
            end
        end
    end)
end

-- Toggle Switch Event
ToggleButton.MouseButton1Click:Connect(function()
    tpWalking = not tpWalking
    if tpWalking then
        ToggleButton.Text = "ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        startTPWalk()
    else
        ToggleButton.Text = "OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        if tpConnection then
            tpConnection:Disconnect()
            tpConnection = nil
        end
    end
end)
